# Local-only development settings. Never commit a real .env file or Firebase JSON file.
APP_ENV=development
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ECOS_API_KEY=
# Paste the whole Firebase service-account JSON as one line in production.
FIREBASE_SERVICE_ACCOUNT_JSON=
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# True without OPENAI_API_KEY returns a clearly labeled local preview answer.
AI_DEMO_MODE=true
